# ── LINE Bot（非 GCP，保留）─────────────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret
# LIFF App ID（從 LINE Developers Console 取得）
LINE_LIFF_ID=your_liff_id

# ── 資料層：PostgreSQL（取代 Firestore）──────────────────────────────────────
STORAGE_DRIVER=postgres
# 分項設定（docker-compose 預設用這組；app 容器內 PGHOST 會被設成 db）
PGHOST=localhost
PGPORT=5432
PGUSER=lineage
PGPASSWORD=change-this-db-password
PGDATABASE=lineage
# 或用單一連線字串（若設定則優先於上面分項）
# DATABASE_URL=postgres://lineage:password@localhost:5432/lineage

# 集合命名模式（legacy=現有大寫 Members/Battles… / canonical=遷移後小寫）
COLLECTION_MODE=legacy

# ── 本地認證（取代 Firebase Auth / Google 登入）──────────────────────────────
# ⚠️ 務必改成一段長亂數，否則 token 可被偽造！
#    產生：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=please-change-to-a-long-random-string
JWT_TTL=30d
# 開發便利：設 true 可略過登入（一律視為公主 role 5）。正式環境務必 false。
AUTH_OPEN_MODE=false

# ── Cloudflare Tunnel（讓 LINE webhook 從外網以 HTTPS 連進 NAS）──────────────
# Cloudflare Zero Trust → Networks → Tunnels 建立後取得 token，
# 並把 public hostname 指到 http://app:3001
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
APP_PORT=3001
NODE_ENV=production

# ── ChromaDB 向量資料庫（選用，非 GCP）───────────────────────────────────────
CHROMA_SERVER_URL=http://localhost:8000
CHROMA_SERVER_TOKEN=

# ── 僅「一次性匯出舊 Firestore 資料」時才需要（跑完即可刪除整段）──────────────
# 搭配 STORAGE_DRIVER=firestore 或 scripts/export-firestore.js 使用
# FIREBASE_PROJECT_ID=lineage-b0156
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@lineage-b0156.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# 或放整包 service account JSON：
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
